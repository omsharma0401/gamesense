# ── Required ──────────────────────────────────────────────────────────────────
VIDEO_DB_API_KEY=          # console.videodb.io — hackathon credits

# ── Free tier, no credit card ─────────────────────────────────────────────────
OPENROUTER_API_KEY=        # openrouter.ai — sign up → Keys
GROQ_API_KEY=              # console.groq.com → Create key (eval judge only)

# ── Optional integrations ─────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=       # Discord channel → Integrations → Webhooks → New

# ── Written automatically by sandbox_start.py — do not set manually ──────────
VIDEODB_SANDBOX_ID=

# ── Overrides (defaults shown) ────────────────────────────────────────────────
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_JUDGE_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
PLAYER_ID=player-001
GAME_NAME=CS2
MOMENT_POLL_INTERVAL=30
KUZU_DB_PATH=./data/kuzu
SQLITE_DB_PATH=./data/gamesense.db
EVENTS_PATH=/tmp/videodb_events.jsonl
